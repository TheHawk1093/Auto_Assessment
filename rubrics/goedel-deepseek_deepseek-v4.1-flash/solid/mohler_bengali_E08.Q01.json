      }
    ],
    "deductions": [],
    "notes": "\u09aa\u09c2\u09b0\u09cd\u09a3 \u09a8\u09ae\u09cd\u09ac\u09b0 \u09aa\u09c7\u09a4\u09c7 \u09b8\u09cd\u099f\u09cd\u09af\u09be\u0995\u0995\u09c7 \u09a1\u09c7\u099f\u09be \u09b8\u09cd\u099f\u09cd\u09b0\u09be\u0995\u099a\u09be\u09b0 \u09ac\u09b2\u09be, \u098f\u099f\u09bf \u0989\u09aa\u09be\u09a6\u09be\u09a8 \u09b8\u0982\u09b0\u0995\u09cd\u09b7\u09a3 \u0995\u09b0\u09c7 \u09ac\u09b2\u09be \u098f\u09ac\u0982 LIFO \u09ac\u09c8\u09b6\u09bf\u09b7\u09cd\u099f\u09cd\u09af (\u09b8\u09b0\u09cd\u09ac\u09b6\u09c7\u09b7\u09c7 \u09af\u09cb\u0997 \u0995\u09b0\u09be \u0989\u09aa\u09be\u09a6\u09be\u09a8 \u09aa\u09cd\u09b0\u09a5\u09ae\u09c7 \u09b8\u09b0\u09be\u09a8\u09cb) \u09ac\u09b2\u09be\u2014\u09a4\u09bf\u09a8\u099f\u09bf\u0987 \u09a5\u09be\u0995\u09a4\u09c7 \u09b9\u09ac\u09c7\u0964 \u09af\u09c7 \u0989\u09a4\u09cd\u09a4\u09b0 \u09b6\u09c1\u09a7\u09c1 \u09a1\u09c7\u099f\u09be \u09b8\u09cd\u099f\u09cd\u09b0\u09be\u0995\u099a\u09be\u09b0 \u09ac\u09b2\u09c7 \u09ac\u09be \u09b6\u09c1\u09a7\u09c1 \u0989\u09aa\u09be\u09a6\u09be\u09a8 \u09b8\u0982\u09b0\u0995\u09cd\u09b7\u09a3\u09c7\u09b0 \u0995\u09a5\u09be \u09ac\u09b2\u09c7, \u09b8\u09c7 \u09b8\u0982\u09b6\u09cd\u09b2\u09bf\u09b7\u09cd\u099f \u09aa\u09df\u09c7\u09a8\u09cd\u099f\u09c7\u09b0 \u0986\u0982\u09b6\u09bf\u0995 \u09a8\u09ae\u09cd\u09ac\u09b0 \u09aa\u09be\u09ac\u09c7\u0964 FIFO \u09ac\u09be \u09aa\u09cd\u09b0\u09a5\u09ae\u09c7 \u09af\u09cb\u0997 \u0995\u09b0\u09be \u0989\u09aa\u09be\u09a6\u09be\u09a8 \u0986\u0997\u09c7 \u09b8\u09b0\u09be\u09a8\u09cb \u09ac\u09b2\u09b2\u09c7 LIFO \u09aa\u09df\u09c7\u09a8\u09cd\u099f\u09c7 \u0995\u09cb\u09a8\u09cb \u09a8\u09ae\u09cd\u09ac\u09b0 \u09aa\u09be\u09ac\u09c7 \u09a8\u09be\u0964",
