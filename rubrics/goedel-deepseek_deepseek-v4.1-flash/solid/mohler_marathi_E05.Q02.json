    "notes": "\u092a\u0942\u0930\u094d\u0923 \u0917\u0941\u0923\u093e\u0902\u0938\u093e\u0920\u0940 \u0921\u093e\u0935\u0940\u0915\u0921\u0942\u0928 \u0909\u091c\u0935\u0940\u0915\u0921\u0947 current element \u0918\u0947\u0923\u0947, \u0909\u0930\u094d\u0935\u0930\u093f\u0924 elements \u092e\u0927\u0942\u0928 \u0915\u093f\u092e\u093e\u0928 \u0936\u094b\u0927\u0923\u0947 \u0906\u0923\u093f \u0924\u094b current element \u0938\u094b\u092c\u0924 swap \u0915\u0930\u0923\u0947 \u092f\u093e \u0924\u0940\u0928\u0939\u0940 \u0917\u094b\u0937\u094d\u091f\u0940 \u0909\u0924\u094d\u0924\u0930\u093e\u0924 \u0938\u094d\u092a\u0937\u094d\u091f \u0905\u0938\u093e\u0935\u094d\u092f\u093e\u0924. P2 \u092e\u0927\u094d\u092f\u0947 \u0915\u093f\u092e\u093e\u0928 \u0936\u094b\u0927\u0923\u094d\u092f\u093e\u091a\u093e \u0909\u0932\u094d\u0932\u0947\u0916 \u0905\u0938\u0947\u0932 \u092a\u0923 '\u0909\u0930\u094d\u0935\u0930\u093f\u0924 elements' \u0938\u094d\u092a\u0937\u094d\u091f \u0928\u0938\u0947\u0932 \u0924\u0930 \u0905\u0930\u094d\u0927\u0947 \u0917\u0941\u0923 \u0926\u094d\u092f\u093e. \u092b\u0915\u094d\u0924 'sort \u0915\u0930\u0924\u094b' \u0905\u0938\u0947 \u0938\u093e\u0902\u0917\u0923\u0947, \u0915\u093f\u0902\u0935\u093e \u091a\u0941\u0915\u0940\u091a\u0940 \u092a\u0926\u094d\u0927\u0924 (\u0909\u0926\u093e. \u0936\u0947\u091c\u093e\u0930\u091a\u094d\u092f\u093e elements \u091a\u0940 \u0905\u0926\u0932\u093e\u092c\u0926\u0932) \u0935\u0930\u094d\u0923\u0928 \u0915\u0947\u0932\u094d\u092f\u093e\u0938 \u0917\u0941\u0923 \u0926\u0947\u090a \u0928\u0915\u093e.",
