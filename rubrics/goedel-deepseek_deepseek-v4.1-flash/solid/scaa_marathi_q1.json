    ],
    "deductions": [],
    "notes": "\u092a\u0942\u0930\u094d\u0923 \u0917\u0941\u0923 \u0924\u0947\u0935\u094d\u0939\u093e\u091a \u092e\u093f\u0933\u0924\u0940\u0932 \u091c\u0947\u0935\u094d\u0939\u093e \u0909\u0924\u094d\u0924\u0930\u093e\u0924 \u092b\u0940\u092e\u0930 \u0906\u0923\u093f \u0936\u094d\u0930\u094b\u0923\u0940/\u0939\u093f\u092a \u092f\u093e\u0902\u091a\u094d\u092f\u093e\u0924\u0940\u0932 \u092c\u0949\u0932-\u0905\u0901\u0921-\u0938\u0949\u0915\u0947\u091f \u0938\u093e\u0902\u0927\u093e \u0905\u0938\u0932\u094d\u092f\u093e\u091a\u0947 \u0938\u094d\u092a\u0937\u094d\u091f\u092a\u0923\u0947 \u0938\u093e\u0902\u0917\u093f\u0924\u0932\u0947 \u0905\u0938\u0947\u0932. \u092b\u0915\u094d\u0924 '\u0938\u093e\u0902\u0927\u093e' \u0905\u0938\u0947 \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0909\u0924\u094d\u0924\u0930 \u0915\u093f\u0902\u0935\u093e \u092b\u0915\u094d\u0924 \u0939\u093e\u0921\u093e\u091a\u0947 \u0928\u093e\u0935 \u0926\u093f\u0932\u094d\u092f\u093e\u0938 \u0917\u0941\u0923 \u092e\u093f\u0933\u0923\u093e\u0930 \u0928\u093e\u0939\u0940\u0924. \u0938\u092e\u0924\u0941\u0932\u094d\u092f \u092a\u0926\u094d\u0927\u0924\u0940\u0928\u0947 \u0926\u093f\u0932\u0947\u0932\u0947 \u092f\u094b\u0917\u094d\u092f \u0909\u0924\u094d\u0924\u0930\u0939\u0940 \u092a\u0942\u0930\u094d\u0923 \u0917\u0941\u0923\u093e\u0902\u0938\u093e\u0920\u0940 \u0938\u094d\u0935\u0940\u0915\u093e\u0930\u093e\u0935\u0947.",
