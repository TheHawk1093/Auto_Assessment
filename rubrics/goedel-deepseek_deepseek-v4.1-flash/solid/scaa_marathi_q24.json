    ],
    "deductions": [],
    "notes": "\u092a\u0942\u0930\u094d\u0923 \u0917\u0941\u0923 \u092e\u093f\u0933\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0909\u0924\u094d\u0924\u0930\u093e\u0924 \u092a\u094d\u0930\u0915\u093e\u0936\u093e\u091a\u0947 \u092a\u0930\u093e\u0935\u0930\u094d\u0924\u0928 \u0939\u093e \u0917\u0941\u0923\u0927\u0930\u094d\u092e \u0938\u094d\u092a\u0937\u094d\u091f\u092a\u0923\u0947 \u0928\u092e\u0942\u0926 \u0915\u0947\u0932\u0947\u0932\u093e \u0905\u0938\u093e\u0935\u093e. \u0915\u0947\u0935\u0933 '\u092a\u094d\u0930\u0915\u093e\u0936' \u0915\u093f\u0902\u0935\u093e '\u0935\u0938\u094d\u0924\u0942 \u092a\u094d\u0930\u0915\u093e\u0936 \u092a\u0930\u0924 \u0915\u0930\u0924\u0947' \u0905\u0938\u0947 \u0905\u092a\u0942\u0930\u094d\u0923 \u0909\u0924\u094d\u0924\u0930 \u0926\u093f\u0932\u094d\u092f\u093e\u0938 \u0917\u0941\u0923 \u092e\u093f\u0933\u0923\u093e\u0930 \u0928\u093e\u0939\u0940\u0924. \u0939\u093e \u092a\u094d\u0930\u0936\u094d\u0928 \u090f\u0915\u0942\u0923 \u0967 \u0917\u0941\u0923\u093e\u091a\u093e \u0905\u0938\u0932\u094d\u092f\u093e\u0928\u0947 \u092a\u0942\u0930\u094d\u0923 \u0915\u093f\u0902\u0935\u093e \u0936\u0942\u0928\u094d\u092f \u0905\u0938\u0947\u091a \u0917\u0941\u0923 \u0926\u094d\u092f\u093e\u0935\u0947.",
