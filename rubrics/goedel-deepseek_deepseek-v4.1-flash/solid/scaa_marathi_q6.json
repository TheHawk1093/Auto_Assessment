    "notes": "\u092a\u0942\u0930\u094d\u0923 \u0917\u0941\u0923 \u092e\u093f\u0933\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0906\u0935\u093e\u091c\u093e\u0924\u0940\u0932 \u092b\u0930\u0915\u093e\u091a\u0947 \u0915\u093e\u0930\u0923 \u0915\u0902\u092a\u0928\u093e\u091a\u0940 \u0935\u0947\u0917\u0935\u0947\u0917\u0933\u0940 \u0935\u093e\u0930\u0902\u0935\u093e\u0930\u0924\u093e \u0906\u0923\u093f \u0924\u094d\u092f\u093e\u092e\u0941\u0933\u0947 \u0928\u093f\u0930\u094d\u092e\u093e\u0923 \u0939\u094b\u0923\u093e\u0930\u0940 \u0935\u0947\u0917\u0935\u0947\u0917\u0933\u0940 \u0909\u091a\u094d\u091a\u0928\u0940\u091a\u0924\u093e \u0905\u0938\u0947 \u0938\u094d\u092a\u0937\u094d\u091f\u092a\u0923\u0947 \u0928\u092e\u0942\u0926 \u0915\u0930\u0923\u0947 \u0906\u0935\u0936\u094d\u092f\u0915 \u0906\u0939\u0947. \u0915\u0947\u0935\u0933 \u0906\u0935\u093e\u091c \u0935\u0947\u0917\u0933\u0947 \u0905\u0938\u0924\u093e\u0924 \u0905\u0938\u0947 \u092a\u0941\u0928\u094d\u0939\u093e \u0932\u093f\u0939\u093f\u0932\u094d\u092f\u093e\u0938 \u0915\u093f\u0902\u0935\u093e \u0915\u093e\u0930\u0923 \u0928 \u0938\u093e\u0902\u0917\u093f\u0924\u0932\u094d\u092f\u093e\u0938 \u0917\u0941\u0923 \u092e\u093f\u0933\u0923\u093e\u0930 \u0928\u093e\u0939\u0940\u0924.",
