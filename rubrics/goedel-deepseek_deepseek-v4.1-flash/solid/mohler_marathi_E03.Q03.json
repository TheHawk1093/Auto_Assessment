    "deductions": [],
    "notes": "\u092a\u0942\u0930\u094d\u0923 \u0917\u0941\u0923 \u0924\u0947\u0935\u094d\u0939\u093e \u092e\u093f\u0933\u0924\u093e\u0924 \u091c\u0947\u0935\u094d\u0939\u093e \u0909\u0924\u094d\u0924\u0930\u093e\u0924 \u092b\u0902\u0915\u094d\u0936\u0928\u091a\u094d\u092f\u093e \u0915\u094b\u0921\u091a\u0940 \u092a\u094d\u0930\u0924 \u0924\u092f\u093e\u0930 \u0939\u094b\u0924\u0947 \u0906\u0923\u093f \u0924\u0940 \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0915\u0949\u0932 \u0938\u093e\u0907\u091f\u0935\u0930 \u0935\u093e\u092a\u0930\u0932\u0940 \u091c\u093e\u0924\u0947 \u0905\u0938\u0947 \u0926\u094b\u0928\u094d\u0939\u0940 \u092e\u0941\u0926\u094d\u0926\u0947 \u0938\u094d\u092a\u0937\u094d\u091f \u0905\u0938\u0924\u093e\u0924. \u0905\u0930\u094d\u0927\u0935\u091f \u0917\u0941\u0923 \u092b\u0915\u094d\u0924 \u092a\u094d\u0930\u0924 \u0924\u092f\u093e\u0930 \u0939\u094b\u0923\u0947 \u0915\u093f\u0902\u0935\u093e \u092b\u0915\u094d\u0924 \u0915\u0949\u0932\u091a\u094d\u092f\u093e \u091c\u093e\u0917\u0940 \u0915\u094b\u0921 \u092f\u0947\u0923\u0947 \u0905\u0936\u093e \u090f\u0915\u093e \u092e\u0941\u0926\u094d\u0926\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092e\u093f\u0933\u0924\u093e\u0924. inline \u092b\u0902\u0915\u094d\u0936\u0928\u091a\u093e \u0905\u0930\u094d\u0925 \u091a\u0941\u0915\u0940\u091a\u093e \u0938\u093e\u0902\u0917\u093f\u0924\u0932\u093e \u0915\u093f\u0902\u0935\u093e \u092b\u0902\u0915\u094d\u0936\u0928 \u0915\u0949\u0932 \u0938\u0941\u0930\u0942\u091a \u0930\u093e\u0939\u0924\u094b \u0905\u0938\u0947 \u092e\u094d\u0939\u091f\u0932\u0947 \u0924\u0930 \u0917\u0941\u0923 \u092e\u093f\u0933\u0924 \u0928\u093e\u0939\u0940\u0924.",
