    "deductions": [],
    "notes": "\u092a\u0942\u0930\u094d\u0923 \u0917\u0941\u0923 \u092e\u093f\u0933\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0909\u0924\u094d\u0924\u0930\u093e\u0924 abstraction \u0906\u0923\u093f reusability \u0939\u0947 \u0926\u094b\u0928\u094d\u0939\u0940 OOP \u091a\u0947 \u092b\u093e\u092f\u0926\u0947 \u092e\u094d\u0939\u0923\u0942\u0928 \u0928\u092e\u0942\u0926 \u0915\u0947\u0932\u0947\u0932\u0947 \u0905\u0938\u093e\u0935\u0947\u0924. \u092b\u0915\u094d\u0924 \u090f\u0915\u091a \u092b\u093e\u092f\u0926\u093e \u0928\u092e\u0942\u0926 \u0915\u0947\u0932\u094d\u092f\u093e\u0938 \u0924\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0917\u0941\u0923\u093e\u0902\u092a\u0930\u094d\u092f\u0902\u0924\u091a \u0917\u0941\u0923 \u0926\u094d\u092f\u093e. \u092f\u093e \u0926\u094b\u0928\u094d\u0939\u0940\u0902\u0936\u0940 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0928\u0938\u0932\u0947\u0932\u094d\u092f\u093e \u0907\u0924\u0930 OOP \u0935\u0948\u0936\u093f\u0937\u094d\u091f\u094d\u092f\u093e\u0902\u0938\u093e\u0920\u0940 \u0917\u0941\u0923 \u0926\u0947\u090a \u0928\u0915\u093e.",
