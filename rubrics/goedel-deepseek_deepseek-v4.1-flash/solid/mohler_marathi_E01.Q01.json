  "rubric": {
    "points": [
      {
        "id": "P1",
        "description": "\u092a\u094d\u0930\u094b\u091f\u094b\u091f\u093e\u0907\u092a \u092a\u094d\u0930\u094b\u0917\u094d\u0930\u093e\u092e\u091a\u0940 \u092d\u0942\u092e\u093f\u0915\u093e \u0907\u091a\u094d\u091b\u093f\u0924 \u0938\u0949\u092b\u094d\u091f\u0935\u0947\u0905\u0930 \u0909\u0924\u094d\u092a\u093e\u0926\u0928\u093e\u091a\u094d\u092f\u093e \u092d\u093e\u0917\u093e\u0902\u091a\u094d\u092f\u093e \u0935\u0930\u094d\u0924\u0928\u093e\u091a\u0947 \u0905\u0928\u0941\u0915\u0930\u0923 (simulation/modeling) \u0915\u0930\u0923\u0947 \u0906\u0939\u0947, \u0905\u0938\u0947 \u0938\u094d\u092a\u0937\u094d\u091f\u092a\u0923\u0947 \u0928\u092e\u0942\u0926 \u0915\u0930\u0924\u0947. '\u0935\u0930\u094d\u0924\u0928\u093e\u091a\u0947 \u0905\u0928\u0941\u0915\u0930\u0923 \u0915\u0930\u0923\u0947' \u092f\u093e\u091a\u093e \u0905\u0930\u094d\u0925 \u0905\u0938\u0932\u0947\u0932\u0947 \u0938\u092e\u0924\u0941\u0932\u094d\u092f \u0936\u092c\u094d\u0926\u0939\u0940 \u0938\u094d\u0935\u0940\u0915\u093e\u0930\u093e\u0930\u094d\u0939 \u0906\u0939\u0947\u0924.",
        "marks": 3.0,
        "partial_credit": "",
        "levels": [],
        "numeric": null
      },
      {
        "id": "P2",
        "description": "\u0905\u0928\u0941\u0915\u0930\u0923 \u0915\u094b\u0923\u0924\u094d\u092f\u093e \u0917\u094b\u0937\u094d\u091f\u0940\u091a\u0947 \u0915\u0930\u093e\u092f\u091a\u0947 \u0906\u0939\u0947 \u0939\u0947 \u0938\u094d\u092a\u0937\u094d\u091f \u0915\u0930\u0924\u0947: \u0907\u091a\u094d\u091b\u093f\u0924/\u092a\u094d\u0930\u0938\u094d\u0924\u093e\u0935\u093f\u0924 \u0938\u0949\u092b\u094d\u091f\u0935\u0947\u0905\u0930 \u0909\u0924\u094d\u092a\u093e\u0926\u0928\u093e\u091a\u094d\u092f\u093e \u092d\u093e\u0917\u093e\u0902\u091a\u0947 (components) \u0935\u0930\u094d\u0924\u0928. \u092b\u0915\u094d\u0924 '\u0938\u0949\u092b\u094d\u091f\u0935\u0947\u0905\u0930' \u0915\u093f\u0902\u0935\u093e '\u092a\u094d\u0930\u094b\u0917\u094d\u0930\u093e\u092e' \u0905\u0938\u0947 \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0909\u0932\u094d\u0932\u0947\u0916 \u092a\u0941\u0930\u0947\u0938\u0947 \u0928\u093e\u0939\u0940\u0924.",
        "marks": 2.0,
        "partial_credit": "",
        "levels": [
          {
            "share": 0.5,
            "says": "\u0907\u091a\u094d\u091b\u093f\u0924 \u0938\u0949\u092b\u094d\u091f\u0935\u0947\u0905\u0930 \u0909\u0924\u094d\u092a\u093e\u0926\u0928\u093e\u091a\u093e \u0909\u0932\u094d\u0932\u0947\u0916 \u0906\u0939\u0947, \u092a\u0923 \u0924\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u092d\u093e\u0917/\u0918\u091f\u0915\u093e\u0902\u091a\u093e \u0938\u094d\u092a\u0937\u094d\u091f \u0909\u0932\u094d\u0932\u0947\u0916 \u0928\u093e\u0939\u0940."
          }
        ],
        "numeric": null
      }
    ],
    "deductions": [],
    "notes": "\u092a\u0942\u0930\u094d\u0923 \u0917\u0941\u0923 \u0924\u0947\u0935\u094d\u0939\u093e \u092e\u093f\u0933\u0924\u093e\u0924 \u091c\u0947\u0935\u094d\u0939\u093e \u0909\u0924\u094d\u0924\u0930 \u092a\u094d\u0930\u094b\u091f\u094b\u091f\u093e\u0907\u092a \u092a\u094d\u0930\u094b\u0917\u094d\u0930\u093e\u092e\u091a\u0947 \u0915\u093e\u0930\u094d\u092f \u092e\u094d\u0939\u0923\u091c\u0947 \u0907\u091a\u094d\u091b\u093f\u0924 \u0938\u0949\u092b\u094d\u091f\u0935\u0947\u0905\u0930 \u0909\u0924\u094d\u092a\u093e\u0926\u0928\u093e\u091a\u094d\u092f\u093e \u092d\u093e\u0917\u093e\u0902\u091a\u094d\u092f\u093e \u0935\u0930\u094d\u0924\u0928\u093e\u091a\u0947 \u0905\u0928\u0941\u0915\u0930\u0923 \u0915\u0930\u0923\u0947 \u0905\u0938\u0947 \u0938\u094d\u092a\u0937\u094d\u091f \u0938\u093e\u0902\u0917\u0924\u0947. P1 \u092a\u0942\u0930\u094d\u0923\u092a\u0923\u0947 \u091a\u0941\u0915\u0940\u091a\u0947 \u0915\u093f\u0902\u0935\u093e \u0905\u0938\u094d\u092a\u0937\u094d\u091f \u0905\u0938\u0932\u094d\u092f\u093e\u0938 \u0924\u094d\u092f\u093e\u091a\u0947 \u0917\u0941\u0923 \u092e\u093f\u0933\u0924 \u0928\u093e\u0939\u0940\u0924; P2 \u092e\u0927\u094d\u092f\u0947 \u092b\u0915\u094d\u0924 \u0938\u0949\u092b\u094d\u091f\u0935\u0947\u0905\u0930 \u0909\u0924\u094d\u092a\u093e\u0926\u0928\u093e\u091a\u093e \u0909\u0932\u094d\u0932\u0947\u0916 \u0905\u0938\u0947\u0932 \u092a\u0923 \u092d\u093e\u0917/\u0918\u091f\u0915 \u0928\u0938\u0924\u0940\u0932 \u0924\u0930 \u0905\u0930\u094d\u0927\u0947 \u0917\u0941\u0923 \u092e\u093f\u0933\u0924\u093e\u0924. \u0935\u093f\u0937\u092f\u093e\u0936\u0940 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0928\u0938\u0932\u0947\u0932\u094d\u092f\u093e \u0915\u093f\u0902\u0935\u093e \u092b\u0915\u094d\u0924 '\u092a\u094d\u0930\u094b\u091f\u094b\u091f\u093e\u0907\u092a \u092e\u094d\u0939\u0923\u091c\u0947 \u0928\u092e\u0941\u0928\u093e' \u0905\u0936\u093e \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0909\u0924\u094d\u0924\u0930\u093e\u0932\u093e \u0917\u0941\u0923 \u092e\u093f\u0933\u0924 \u0928\u093e\u0939\u0940\u0924.",
