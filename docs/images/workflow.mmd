flowchart TD
    subgraph IN["1 · Intake (teacher files)"]
        P["Question paper<br/>txt · md · docx · pdf · json"]
        R["Reference / rubric<br/>(optional)"]
        A["Student answers<br/>folder · json · OCR output"]
        P --> I["intake/<br/>paper · reference · answers · rules · identity"]
        R --> I
        A --> I
        I --> IT[("Items:<br/>question · model answer<br/>student answer · max mark · kind")]
    end

    subgraph SCH["2 · Marking scheme (once per question)"]
        RW["rubric.py<br/>writer drafts points"] --> RT["self-test<br/>model answer must score full,<br/>'don't know' must score zero"]
        RT -->|fail: rewrite once| RW
        RT -->|pass| RC[("rubrics/ cache<br/>by model + variant")]
    end

    subgraph MK["3 · Marking (every student answer, in parallel)"]
        CK["checks.py<br/>MCQ · numeric · code · figure<br/>decided by code, no model"]
        RD["read.py<br/>first pass on the answer alone"]
        GR["grade.py<br/>per-point verdict + quoted evidence"]
        VF["verify.py<br/>quotes real? marks sum? form gate<br/>one retry, then repair"]
        CK --> RD --> GR --> VF
        VF -->|checks fail| GR
    end

    subgraph FB["4 · Feedback and output"]
        FW["feedback.py<br/>from the verified marking only"]
        OUT["runs/&lt;name&gt;/<br/>schemes.md · marks.csv<br/>students/*.md · report.html"]
        FW --> OUT
    end

    IT --> RC
    RC --> CK
    IT --> CK
    VF -->|verified marks| FW
    VF -.->|doubtful| ESC["cascade / vote<br/>stronger or second model"]
    ESC -.-> VF
    OUT --> APP["Streamlit app<br/>override · publish · regrade"]

    LLM{{"llm/ ask(system, user, Model)<br/>claude_cli · anthropic · openrouter<br/>goedel · gemini · mock"}}
    RW -.-> LLM
    RD -.-> LLM
    GR -.-> LLM
    FW -.-> LLM
    I -.-> LLM
