# Copy to .env and fill in the keys. Never commit .env.
# The offline `mock` backend (configs/mock.yaml) needs none of these.

# OpenRouter: every marking call and the handwriting readers (llm.backend: openrouter)
OPENROUTER_API_KEY=

# Bodhan IndicOCR: the reader for Hindi, Marathi and other Indian scripts
INDIC_OCR_API_KEY=
