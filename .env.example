# Copy to .env and fill only the backends you use. Never commit .env.
# The offline `mock` backend (configs/mock.yaml) needs none of these.

# Anthropic API backend (llm.backend: anthropic)
ANTHROPIC_API_KEY=

# DeepSeek via Goedel Machines (llm.backend: goedel)
GOEDEL_API_KEY=

# OpenRouter backend (llm.backend: openrouter): the release route, off by default in the app
OPENROUTER_API_KEY=

# Gemini text/OCR backend (reading handwriting)
GEMINI_API_KEY=

# Bodhan IndicOCR: a fallback reader for Indian scripts (the last entry of `ocr.fallbacks` in configs/exam.yaml)
INDIC_OCR_API_KEY=
